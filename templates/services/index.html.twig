{% extends 'base.html.twig' %}

{% block title %}Services — Eyseal{% endblock %}

{% block body %}

<main>

    <section class="container py-5">
        <div class="text-center mb-5">
            <h1>Mes services</h1>
            <p class="lead">
                Des solutions numériques adaptées aux besoins des professionnels.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title h4">Développement web</h2>
                        <p class="card-text">
                            Création de sites web et d'applications sur mesure
                            avec Symfony, PHP et les technologies web modernes.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title h4">WordPress</h2>
                        <p class="card-text">
                            Création, personnalisation, optimisation et
                            maintenance de sites WordPress.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title h4">Maintenance informatique</h2>
                        <p class="card-text">
                            Assistance, maintenance et accompagnement pour
                            les équipements et environnements informatiques.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title h4">Cybersécurité</h2>
                        <p class="card-text">
                            Accompagnement autour de la sécurité informatique,
                            des bonnes pratiques et de la protection des systèmes.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title h4">SEO &amp; accessibilité</h2>
                        <p class="card-text">
                            Audit SEO et amélioration de l'accessibilité
                            numérique selon les bonnes pratiques du RGAA.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title h4">Graphisme</h2>
                        <p class="card-text">
                            Création de logos, supports graphiques et chartes
                            graphiques pour développer votre identité visuelle.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </section>

</main>

{% endblock %}