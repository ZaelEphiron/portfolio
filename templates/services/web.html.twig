{% extends 'base.html.twig' %}

{% block title %}Développement web — Eyseal{% endblock %}

{% block body %}

<main>

    <section class="services-hero py-5">
        <div class="container py-lg-5">

            <div class="row justify-content-center text-center">

                <div class="col-lg-9">

                    <div class="hero-badge mb-4">
                        <span class="hero-badge-dot"></span>
                        Développement web
                    </div>

                    <h1 class="hero-title mb-4 mx-auto">
                        Des sites web
                        <span>pensés pour vos besoins.</span>
                    </h1>

                    <p class="hero-text mb-0 mx-auto">
                        Création de sites vitrines et d'applications web
                        sur mesure, avec des technologies modernes et une
                        attention particulière portée à la performance,
                        à la sécurité et à l'expérience utilisateur.
                    </p>

                </div>

            </div>

        </div>
    </section>

    <section class="container py-5">

        <div class="text-center mb-5">
            <h2>Ce que je propose</h2>

