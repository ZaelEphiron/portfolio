{% extends 'base.html.twig' %}

{% block title %}Offre Essentielle — Eyseal{% endblock %}

{% block body %}

<main>

    <section class="services-hero py-5">
        <div class="container py-lg-5">

            <div class="row justify-content-center text-center">

                <div class="col-lg-9">

                    <div class="hero-badge mb-4">
                        <span class="hero-badge-dot"></span>
                        Offre Essentielle
                    </div>

                    <h1 class="hero-title mb-4 mx-auto">
                        Une présence professionnelle
                        <span>en ligne, simplement.</span>
                    </h1>

                    <p class="hero-text mb-4 mx-auto">
                        Une solution adaptée aux professionnels qui souhaitent
                        disposer d'un site vitrine moderne, clair et efficace
                        pour présenter leur activité sur le web.
                    </p>

                    <a href="#prestations" class="btn btn-info btn-lg">
                        Découvrir les prestations
                        <i class="bi bi-arrow-down ms-2"></i>
                    </a>

                </div>

            </div>

        </div>
    </section>

    {# Prestations incluses #}
    <section id="prestations" class="container py-5">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <span class="hero-badge mb-3">Ce qui est inclus</span>
                <h2 class="mb-3">L'essentiel pour lancer votre présence en ligne</h2>
                <p class="text-white">
                    Une solution claire et professionnelle pour présenter votre activité,
                    valoriser vos services et permettre à vos futurs clients de vous contacter.
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Site vitrine</h3>
                    <p class="text-white mb-0">
                        Une présentation de votre activité, de vos services et de vos coordonnées
                        dans un site adapté à votre identité professionnelle.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Design responsive</h3>
                    <p class="text-white mb-0">
                        Une interface conçue pour rester lisible et agréable sur ordinateur,
                        tablette et smartphone.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Contact simplifié</h3>
                    <p class="text-white mb-0">
                        Des coordonnées visibles et un accès simple pour que vos visiteurs
                        puissent vous contacter.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Bases du référencement</h3>
                    <p class="text-white mb-0">
                        Une structure de page et des informations essentielles préparées
                        pour faciliter la compréhension du site par les moteurs de recherche.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Sécurité de base</h3>
                    <p class="text-white mb-0">
                        Une attention portée aux bonnes pratiques de développement et à la
                        configuration initiale du site.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Mise en ligne</h3>
                    <p class="text-white mb-0">
                        Un accompagnement pour préparer la publication du site, selon
                        l'hébergement et les conditions convenus ensemble.
                    </p>
                </div>
            </div>
        </div>
    </section>

    {# Tarif de l'offre #}
    <section class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-6">

                <div class="services-card p-4 p-md-5 text-center">

                    <span class="hero-badge mb-3">Une offre accessible</span>

                    <h2 class="mb-3">Offre Essentielle</h2>

                    <p class="text-white mb-4">
                        Un site vitrine professionnel pour présenter votre activité
                        et commencer à développer votre présence en ligne.
                    </p>

                    <div class="mb-4">
                        <span class="display-3 fw-bold text-info">390 €</span>
                        <p class="text-white mt-2 mb-0">
                            Tarif indicatif, à confirmer selon votre projet
                        </p>
                    </div>

                    <ul class="list-unstyled text-start mx-auto mb-4" style="max-width: 380px;">
                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Site vitrine de 1 à 3 pages
                        </li>
                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Design responsive : ordinateur, tablette et mobile
                        </li>
                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Coordonnées et moyens de contact
                        </li>
                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Référencement naturel de base (SEO)
                        </li>
                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Aide à la rédaction jusqu'à 500 mots au total
                        </li>
                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Deux séries de corrections incluses
                        </li>
                        <li class="mb-0">
                            <span class="text-info me-2">✓</span>
                            Accompagnement à la mise en ligne
                        </li>
                    </ul>

                    <p class="text-white small mb-4">
                        Le client fournit ses textes et ses visuels. Une aide à la rédaction
                        est incluse dans la limite de 500 mots au total.
                    </p>

                    <div class="text-start p-3 rounded mb-4" style="background-color: rgba(255, 255, 255, 0.04);">
    
                        <h3 class="h6 mb-2">À prévoir en supplément</h3>

                        <p class="text-white small mb-0">
                            Le nom de domaine, l'hébergement, les pages supplémentaires,
                            les nouvelles fonctionnalités et les demandes dépassant le périmètre
                            défini seront chiffrés séparément avant toute intervention.
                        </p>

                    </div>

                    <a href="{{ path('app_contact', {
                        sujet: 'Demande de devis - Offre Essentielle',
                        message: "Bonjour, je souhaite obtenir un devis pour l'offre Essentielle d'Eyseal.\n\nVoici quelques informations sur mon projet :"
                    }) }}"
                    class="btn btn-info btn-lg w-100">
                        Demander un devis
                    </a>

                </div>

            </div>
        </div>
    </section>

</main>

{% endblock %}