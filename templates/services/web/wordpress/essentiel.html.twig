{% extends 'base.html.twig' %}

{% block title %}Offre Essentielle CMS — Eyseal{% endblock %}

{% block body %}

<main>

    {# Présentation de l'offre #}
    <section class="services-hero py-5">
        <div class="container py-lg-5">

            <div class="row justify-content-center text-center">
                <div class="col-lg-9">

                    <div class="hero-badge mb-4">
                        <span class="hero-badge-dot"></span>
                        Offre Essentielle CMS
                    </div>

                    <h1 class="hero-title mb-4 mx-auto">
                        Votre site WordPress,
                        <span>simplement et efficacement.</span>
                    </h1>

                    <p class="hero-text mb-4 mx-auto">
                        Une solution accessible pour créer une présence professionnelle
                        en ligne, présenter votre activité et gérer facilement vos contenus
                        grâce à WordPress.
                    </p>

                    <a href="#prestations" class="btn btn-info btn-lg">
                        Découvrir les prestations
                        <i class="bi bi-arrow-down ms-2"></i>
                    </a>

                </div>
            </div>

        </div>
    </section>

    {# Prestations incluses #}
    <section id="prestations" class="container py-5">

        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <span class="hero-badge mb-3">Ce qui est inclus</span>

                <h2 class="mb-3">L'essentiel pour votre site WordPress</h2>

                <p class="text-white">
                    Un site vitrine adapté à votre activité, avec une présentation
                    soignée, les fonctionnalités indispensables et une prise en main
                    facilitée pour vous permettre de gérer vos contenus.
                </p>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Site vitrine WordPress</h3>
                    <p class="text-white mb-0">
                        Un site de 1 à 5 pages pour présenter votre activité,
                        vos services, vos coordonnées et les informations essentielles
                        à vos visiteurs.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Thème personnalisé</h3>
                    <p class="text-white mb-0">
                        Adaptation d'un thème existant à votre identité visuelle :
                        couleurs, typographies, logo et principaux éléments graphiques,
                        dans les limites du thème choisi.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Design responsive</h3>
                    <p class="text-white mb-0">
                        Une présentation adaptée aux ordinateurs, tablettes et
                        smartphones pour faciliter la consultation de votre site.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Fonctionnalités essentielles</h3>
                    <p class="text-white mb-0">
                        Configuration des fonctionnalités courantes, notamment
                        un formulaire de contact, selon les besoins définis
                        pour votre projet.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">SEO et sécurité de base</h3>
                    <p class="text-white mb-0">
                        Réglages essentiels du référencement naturel et configuration
                        initiale attentive aux bonnes pratiques de sécurité de WordPress.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="services-card h-100 p-4">
                    <h3 class="h5 mb-3">Prise en main du CMS</h3>
                    <p class="text-white mb-0">
                        Une présentation du tableau de bord pour vous aider à modifier
                        vos textes, vos images et vos contenus en autonomie.
                    </p>
                </div>
            </div>

        </div>
    </section>

    {# Présentation tarifaire : montant à définir #}
    <section class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-6">

                <div class="services-card p-4 p-md-5 text-center">

                    <span class="hero-badge mb-3">Une solution accessible</span>

                    <h2 class="mb-3">Offre Essentielle CMS</h2>

                    <p class="text-white mb-4">
                        Un site WordPress professionnel, personnalisé à votre image
                        et simple à administrer au quotidien.
                    </p>

                    <div class="mb-4">
                        <span class="h4 fw-bold text-info">
                            Tarif sur devis
                        </span>
                        <p class="text-white mt-2 mb-0">
                            Selon le périmètre et les besoins de votre projet
                        </p>
                    </div>

                    <ul class="list-unstyled text-start mx-auto mb-4"
                        style="max-width: 380px;">

                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Site vitrine de 1 à 5 pages
                        </li>

                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Installation et configuration de WordPress
                        </li>

                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Personnalisation légère d'un thème existant
                        </li>

                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Formulaire de contact et fonctionnalités courantes
                        </li>

                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Réglages SEO et sécurité de base
                        </li>

                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Aide rédactionnelle jusqu'à 500 mots au total
                        </li>

                        <li class="mb-3">
                            <span class="text-info me-2">✓</span>
                            Deux séries de corrections incluses
                        </li>

                        <li class="mb-0">
                            <span class="text-info me-2">✓</span>
                            Présentation du tableau de bord WordPress
                        </li>

                    </ul>

                    <p class="text-white small mb-4">
                        Le client fournit ses textes et ses visuels.
                        Une aide rédactionnelle est incluse dans la limite
                        de 500 mots au total.
                    </p>

                    <div class="text-start p-3 rounded mb-4"
                         style="background-color: rgba(255, 255, 255, 0.04);">

                        <h3 class="h6 mb-2">À prévoir en supplément</h3>

                        <p class="text-white small mb-0">
                            Le nom de domaine, l'hébergement, les licences et extensions
                            payantes ainsi que les fonctionnalités complexes ne sont pas
                            inclus. Toute demande supplémentaire fera l'objet d'un devis
                            complémentaire avant intervention.
                        </p>

                    </div>

                    <a href="{{ path('app_contact', {
                        sujet: 'Demande de devis - Offre Essentielle CMS',
                        message: "Bonjour, je souhaite obtenir un devis pour l'offre Essentielle CMS d'Eyseal.\n\nVoici quelques informations sur mon projet :"
                    }) }}"
                    class="btn btn-info btn-lg w-100">
                        Demander un devis
                    </a>

                </div>

            </div>
        </div>
    </section>

</main>

{% endblock %}