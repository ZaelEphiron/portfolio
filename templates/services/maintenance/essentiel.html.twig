{% extends 'base.html.twig' %}

{% block title %}Maintenance informatique — Eyseal{% endblock %}

{% block meta_description %}
Découvrez les prestations de maintenance informatique Eyseal : dépannage, mises à jour, optimisation, sécurité et entretien de vos ordinateurs, à distance ou sur place.
{% endblock %}

{% block body %}

<main>

    <section class="services-hero py-5">
        <div class="container py-lg-5">

            <div class="row justify-content-center text-center">
                <div class="col-lg-9">

                    <div class="hero-badge mb-4">
                        <span class="hero-badge-dot"></span>
                        Maintenance informatique
                    </div>

                    <h1 class="hero-title mb-4">
                        Un informatique plus fiable,
                        au quotidien.
                    </h1>

                    <p class="hero-text mb-4">
                        Dépannage, entretien et optimisation de vos ordinateurs :
                        des prestations adaptées aux particuliers et aux
                        professionnels, à distance ou sur place selon le besoin.
                    </p>

                    <a href="{{ path('app_contact', {
                        sujet: 'Demande de devis - Maintenance informatique',
                        message: "Bonjour, je souhaite obtenir des informations sur les prestations de maintenance informatique d'Eyseal.\n\nVoici quelques informations sur mon besoin :"
                    }) }}" class="btn btn-info btn-lg">
                        Demander un devis
                    </a>

                </div>
            </div>

        </div>
    </section>

    <section class="py-5">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="mb-3">Des prestations adaptées à vos besoins</h2>
                <p class="text-secondary">
                    Choisissez une intervention ponctuelle ou un forfait
                    clairement défini.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-6 col-lg-4">
                    <article class="services-card h-100">
                        <div class="card-body">
                            <div class="service-icon">01</div>

                            <h3 class="card-title h4">
                                Diagnostic et dépannage
                            </h3>

                            <p class="card-text">
                                Recherche de problèmes Windows, logiciels
                                et périphériques, avec proposition d'une
                                solution adaptée.
                            </p>
                        </div>
                    </article>
                </div>

                <div class="col-md-6 col-lg-4">
                    <article class="services-card h-100">
                        <div class="card-body">
                            <div class="service-icon">02</div>

                            <h3 class="card-title h4">
                                Installation et configuration
                            </h3>

                            <p class="card-text">
                                Installation de logiciels compatibles et
                                configuration des paramètres système selon
                                vos besoins.
                            </p>
                        </div>
                    </article>
                </div>

                <div class="col-md-6 col-lg-4">
                    <article class="services-card h-100">
                        <div class="card-body">
                            <div class="service-icon">03</div>

                            <h3 class="card-title h4">
                                Mises à jour
                            </h3>

                            <p class="card-text">
                                Vérification des mises à jour de Windows,
                                des pilotes et du bon fonctionnement
                                de l'ordinateur.
                            </p>
                        </div>
                    </article>
                </div>

                <div class="col-md-6 col-lg-4">
                    <article class="services-card h-100">
                        <div class="card-body">
                            <div class="service-icon">04</div>

                            <h3 class="card-title h4">
                                Optimisation logicielle
                            </h3>

                            <p class="card-text">
                                Analyse des ralentissements, contrôle des
                                programmes au démarrage et optimisations
                                adaptées à votre configuration.
                            </p>
                        </div>
                    </article>
                </div>

                <div class="col-md-6 col-lg-4">
                    <article class="services-card h-100">
                        <div class="card-body">
                            <div class="service-icon">05</div>

                            <h3 class="card-title h4">
                                Sécurité de base
                            </h3>

                            <p class="card-text">
                                Vérification des paramètres de sécurité,
                                contrôle de la protection antivirus et
                                conseils de prévention.
                            </p>
                        </div>
                    </article>
                </div>

                <div class="col-md-6 col-lg-4">
                    <article class="services-card h-100">
                        <div class="card-body">
                            <div class="service-icon">06</div>

                            <h3 class="card-title h4">
                                Sauvegarde et conseils
                            </h3>

                            <p class="card-text">
                                Conseils pour protéger vos fichiers,
                                organiser vos sauvegardes et adopter
                                de bonnes pratiques informatiques.
                            </p>
                        </div>
                    </article>
                </div>

            </div>

        </div>
    </section>

    <section class="py-5">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="mb-3">Nos formules</h2>
                <p class="text-secondary">
                    Des tarifs définis pour les prestations courantes.
                    Les déplacements sont facturés séparément.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-6 col-lg-3">
                    <article class="services-card h-100">
                        <div class="card-body d-flex flex-column">

                            <h3 class="card-title h5">
                                Intervention ponctuelle
                            </h3>

                            <p class="text-info fw-semibold">
                                À partir de 40 €/h
                            </p>

                            <p class="card-text">
                                Pour résoudre un problème précis ou
                                répondre à un besoin occasionnel.
                            </p>

                            <ul class="card-text">
                                <li>À distance : 40 €/h</li>
                                <li>Sur place : 50 €/h</li>
                                <li>Diagnostic et dépannage courant</li>
                                <li>Vérification du résultat</li>
                            </ul>

                            <p class="text-secondary small mt-auto">
                                Déplacement en supplément selon la zone.
                            </p>

                        </div>
                    </article>
                </div>

                <div class="col-md-6 col-lg-3">
                    <article class="services-card h-100">
                        <div class="card-body d-flex flex-column">

                            <h3 class="card-title h5">
                                Forfait Entretien
                            </h3>

                            <p class="text-info fw-semibold">
                                59 € / ordinateur
                            </p>

                            <p class="card-text">
                                Pour l'entretien logiciel courant
                                d'un ordinateur.
                            </p>

                            <ul class="card-text">
                                <li>Vérification des mises à jour</li>
                                <li>Contrôle de sécurité de base</li>
                                <li>Vérification des performances</li>
                                <li>Nettoyage logiciel adapté</li>
                                <li>Conseils de sauvegarde</li>
                            </ul>

                            <p class="text-secondary small mt-auto">
                                Hors dépannage complexe et réinstallation.
                            </p>

                        </div>
                    </article>
                </div>

                <div class="col-md-6 col-lg-3">
                    <article class="services-card h-100">
                        <div class="card-body d-flex flex-column">

                            <h3 class="card-title h5">
                                Forfait Optimisation
                            </h3>

                            <p class="text-info fw-semibold">
                                89 € / ordinateur
                            </p>

                            <p class="card-text">
                                Pour analyser et traiter les ralentissements
                                logiciels courants.
                            </p>

                            <ul class="card-text">
                                <li>Diagnostic des ralentissements</li>
                                <li>Contrôle du démarrage</li>
                                <li>Vérification des mises à jour</li>
                                <li>Optimisations logicielles adaptées</li>
                                <li>Bilan et recommandations</li>
                            </ul>

                            <p class="text-secondary small mt-auto">
                                Hors réparation matérielle et réinstallation.
                            </p>

                        </div>
                    </article>
                </div>

                <div class="col-md-6 col-lg-3">
                    <article class="services-card h-100">
                        <div class="card-body d-flex flex-column">

                            <h3 class="card-title h5">
                                Maintenance professionnelle
                            </h3>

                            <p class="text-info fw-semibold">
                                Sur devis
                            </p>

                            <p class="card-text">
                                Pour les indépendants et les petites
                                entreprises souhaitant entretenir leur
                                parc informatique.
                            </p>

                            <ul class="card-text">
                                <li>Nombre de postes défini</li>
                                <li>Entretien planifié</li>
                                <li>Vérifications de sécurité</li>
                                <li>Bilan et recommandations</li>
                                <li>Suivi récurrent possible</li>
                            </ul>

                            <p class="text-secondary small mt-auto">
                                Fréquence et périmètre définis ensemble.
                            </p>

                        </div>
                    </article>
                </div>

            </div>

        </div>
    </section>

    <section class="py-5">
        <div class="container">

            <div class="row justify-content-center">
                <div class="col-lg-9">

                    <div class="services-card">
                        <div class="card-body p-4 p-lg-5 text-center">

                            <h2 class="mb-4">
                                Une intervention adaptée à votre situation
                            </h2>

                            <p class="card-text">
                                Chaque ordinateur et chaque problème sont
                                différents. Si le diagnostic révèle un besoin
                                qui dépasse la prestation prévue, une solution
                                complémentaire vous sera proposée avant toute
                                intervention supplémentaire.
                            </p>

                            <p class="card-text">
                                Les réparations matérielles, la récupération
                                complexe de données, les réinstallations
                                complètes et les interventions réseau avancées
                                nécessitent une évaluation distincte.
                            </p>

                            <p class="text-secondary small mb-4">
                                Les tarifs affichés sont à confirmer selon le
                                statut applicable et le traitement de la TVA.
                                Les frais de déplacement, licences et pièces
                                éventuelles ne sont pas inclus.
                            </p>

                            <a href="{{ path('app_contact', {
                                sujet: 'Demande de devis - Maintenance informatique',
                                message: "Bonjour, je souhaite obtenir un devis pour une prestation de maintenance informatique.\n\nType de besoin :\nÉquipement concerné :\nMode d'intervention souhaité :"
                            }) }}" class="btn btn-info">
                                Décrire mon besoin
                            </a>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </section>

</main>

{% endblock %}