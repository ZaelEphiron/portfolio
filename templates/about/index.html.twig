{% extends 'base.html.twig' %}

{% block title %}À propos — Eyseal{% endblock %}

{% block body %}

<main>

    {# Introduction #}
    <section class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-9 text-center">

                <p class="text-info fw-semibold mb-2">
                    À PROPOS D'EYSEAL
                </p>

                <h1 class="display-5 fw-bold mb-4">
                    Un profil à la croisée du web,
                    de l'informatique et de la sécurité.
                </h1>

                <p class="lead">
                    Eyseal est né de la volonté de proposer des solutions
                    numériques à la fois modernes, accessibles et pensées
                    avec une attention particulière portée à la sécurité.
                </p>

            </div>

        </div>

    </section>


    {# Parcours #}
    <section class="container py-5">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <h2 class="mb-4">Mon parcours</h2>

                <p>
                    Mon parcours professionnel m'a permis de développer une
                    vision polyvalente de l'informatique, allant du support
                    et de la maintenance jusqu'au développement web et à la
                    cybersécurité.
                </p>

                <p>
                    Titulaire d'un Master 2 en sécurité des systèmes, je
                    m'intéresse particulièrement aux problématiques liées
                    à la protection des systèmes d'information et à
                    l'intégration de la sécurité dans les projets
                    informatiques.
                </p>

                <p>
                    Je développe également mes compétences en DevOps et
                    DevSecOps afin de mieux comprendre l'ensemble du cycle
                    de vie d'une application, de son développement jusqu'à
                    son déploiement et sa sécurisation.
                </p>

            </div>


            <div class="col-lg-6">

                <div class="card h-100">

                    <div class="card-body p-4">

                        <h3 class="h4 mb-4">
                            Mon approche
                        </h3>

                        <p>
                            Chaque projet doit répondre à un besoin concret.
                            Je privilégie donc des solutions simples,
                            maintenables et adaptées au contexte du client.
                        </p>

                        <p>
                            La performance, la sécurité, l'accessibilité et
                            la facilité d'utilisation font partie des
                            critères que je cherche à intégrer dès la
                            conception.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    {# Compétences #}
    <section class="container py-5">

        <div class="text-center mb-5">

            <h2>Mes compétences</h2>

            <p class="text-body-secondary">
                Un profil polyvalent autour de plusieurs domaines
                complémentaires.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-md-6 col-lg-4">

                <div class="card h-100">

                    <div class="card-body">

                        <h3 class="h4">Développement</h3>

                        <p>
                            PHP, Symfony, JavaScript, Bootstrap, MySQL,
                            WordPress et conception de sites web.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="card h-100">

                    <div class="card-body">

                        <h3 class="h4">Systèmes &amp; réseaux</h3>

                        <p>
                            Administration, maintenance, support,
                            environnement Windows et compréhension des
                            infrastructures informatiques.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="card h-100">

                    <div class="card-body">

                        <h3 class="h4">Cybersécurité</h3>

                        <p>
                            Sécurité des systèmes d'information, bonnes
                            pratiques, analyse des risques et sensibilisation.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="card h-100">

                    <div class="card-body">

                        <h3 class="h4">DevOps &amp; DevSecOps</h3>

                        <p>
                            Automatisation, CI/CD, contrôle de version,
                            intégration de la sécurité et culture
                            DevSecOps.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="card h-100">

                    <div class="card-body">

                        <h3 class="h4">SEO &amp; accessibilité</h3>

                        <p>
                            Audit SEO, bonnes pratiques web et amélioration
                            de l'accessibilité numérique selon le RGAA.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="card h-100">

                    <div class="card-body">

                        <h3 class="h4">Graphisme</h3>

                        <p>
                            Création de supports graphiques, logos et
                            éléments d'identité visuelle.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    {# Positionnement #}
    <section class="container py-5">

        <div class="card">

            <div class="card-body text-center p-5">

                <h2>Une approche orientée solutions</h2>

                <p class="lead mb-4">
                    L'objectif d'Eyseal est de réunir technologie,
                    sécurité et simplicité pour créer des solutions
                    numériques réellement utiles.
                </p>

                <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">
                    Parlons de votre projet
                </a>

            </div>

        </div>

    </section>

</main>

{% endblock %}