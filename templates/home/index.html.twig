{% extends 'base.html.twig' %}

{% block title %}Accueil — Eyseal{% endblock %}

{% block body %}

<main>

    {# Hero #}
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center min-vh-75 py-5">

                <div class="col-lg-7">

                    <div class="hero-badge mb-4">
                        <span class="hero-badge-dot"></span>
                        Solutions web · IT · cybersécurité
                    </div>

                    <h1 class="hero-title mb-4">
                        Des solutions numériques
                        <span>qui font la différence.</span>
                    </h1>

                    <p class="hero-text mb-4">
                        Eyseal accompagne les professionnels dans la création,
                        l'évolution et la sécurisation de leurs projets numériques.
                    </p>

                    <div class="d-flex justify-content-center gap-3 flex-wrap mt-5">
                        <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg px-4">
                            Parlons de votre projet
                        </a>

                        <a href="{{ path('app_services') }}" class="btn btn-outline-info btn-lg px-4">
                            Découvrir mes services
                        </a>
                    </div>

                </div>

                <div class="col-lg-5 d-none d-lg-flex justify-content-center">

                    <div class="hero-visual">
                        <div class="hero-grid"></div>

                        <div class="hero-circle hero-circle-1"></div>
                        <div class="hero-circle hero-circle-2"></div>

                        <div class="hero-card">
                            <div class="hero-card-header">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>

                            <div class="hero-card-body">
                                <div class="hero-code-line long"></div>
                                <div class="hero-code-line medium"></div>
                                <div class="hero-code-line short"></div>
                                <div class="hero-code-line medium"></div>
                                <div class="hero-code-line long"></div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </section>


    {# Présentation #}
    <section class="container py-5">

        <div class="row justify-content-center">
            <div class="col-lg-9 text-center">

                <h2 class="mb-4">
                    Un accompagnement numérique polyvalent
                </h2>

                <p class="lead">
                    Développement web, informatique, cybersécurité,
                    référencement, accessibilité et identité visuelle :
                    Eyseal propose un accompagnement adapté aux besoins
                    des professionnels.
                </p>

            </div>
        </div>

    </section>


    {# Services principaux #}
    <section class="container py-5">

        <div class="text-center mb-5">
            <h2>Mes services</h2>
            <p class="text-body-secondary">
                Des prestations adaptées à vos besoins numériques.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h4">Développement web</h3>
                        <p>
                            Création de sites et d'applications web
                            modernes avec Symfony, PHP et les technologies
                            web adaptées à votre projet.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h4">WordPress</h3>
                        <p>
                            Création, personnalisation, optimisation et
                            maintenance de sites WordPress.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h4">Informatique</h3>
                        <p>
                            Assistance, maintenance et accompagnement
                            informatique pour les professionnels.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h4">Cybersécurité</h3>
                        <p>
                            Bonnes pratiques, sensibilisation et
                            accompagnement autour de la sécurité
                            informatique.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h4">SEO &amp; accessibilité</h3>
                        <p>
                            Audit SEO et amélioration de l'accessibilité
                            numérique selon les bonnes pratiques du RGAA.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h4">Identité visuelle</h3>
                        <p>
                            Création de logos, supports graphiques et
                            chartes graphiques pour renforcer votre image.
                        </p>
                    </div>
                </div>
            </div>

        </div>

        <div class="text-center mt-5">
            <a href="{{ path('app_services') }}" class="btn btn-outline-info">
                Découvrir tous les services
            </a>
        </div>

    </section>


    {# Réalisations #}
    <section class="container py-5">

        <div class="row align-items-center">

            <div class="col-lg-8 text-center">
                <h2>Des projets concrets</h2>

                <p class="lead">
                    Découvrez des réalisations web, techniques et
                    DevSecOps développées au cours de mon parcours.
                </p>
            </div>

            <div class="col-lg-4 d-flex justify-content-center">
                <a href="{{ path('app_projects') }}" class="btn btn-primary">
                    Voir mes réalisations
                </a>
            </div>

        </div>

    </section>


    {# À propos #}
    <section class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-9 text-center">

                <h2>À propos d'Eyseal</h2>

                <p class="lead">
                    Eyseal s'appuie sur un profil combinant développement
                    web, systèmes et réseaux, cybersécurité et culture
                    DevSecOps.
                </p>

                <a href="{{ path('app_about') }}" class="btn btn-outline-info">
                    Découvrir mon parcours
                </a>

            </div>

        </div>

    </section>


    {# Contact #}
    <section class="container py-5">

        <div class="card">
            <div class="card-body text-center p-5">

                <h2>Un projet ? Parlons-en.</h2>

                <p class="lead mb-4">
                    Vous avez un besoin en développement web, informatique,
                    cybersécurité ou communication numérique ?
                </p>

                <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">
                    Demander un échange
                </a>

            </div>
        </div>

    </section>

</main>

{% endblock %}